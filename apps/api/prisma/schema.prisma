// prisma/schema.prisma
// Esquema principal do banco para o MVP do sistema interno de ISP.
// Chaves primárias em UUID v4 para facilitar sincronização futura com ERP/CRM.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  MASTER_ADMIN
  ADMIN
  SUPERVISOR
  COORDENADOR
  DIRETORIA
  TECNICO
  FINANCEIRO
  COMERCIAL
  OPERADOR_CAIXA
}

enum PermissionCode {
  USERS_READ
  USERS_WRITE
  REPORTS_READ
  AUDIT_READ
  ORDERS_READ
  ORDERS_WRITE
  ORDERS_STATUS_WRITE
  ORDERS_NOTE_WRITE
  CHECKLIST_READ
  CHECKLIST_WRITE
  CASH_READ
  CASH_WRITE
  APPROVE_CLOSURE
  APPROVE_LATE_CHECKLIST
}

enum StatusOrdemRemocao {
  ABERTO
  ROTEIRIZADO
  CONCLUIDO
  FALHA_TENTATIVA
  EM_OBSERVACAO
}

enum StatusRotaRemocao {
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum SubstatusFalha {
  CLIENTE_AUSENTE
  RECUSA
  MUDOU_SE
  ENDERECO_NAO_LOCALIZADO
}

enum TipoRespostaChecklist {
  OK
  NAO_CONFORME
  TEXTO
}

enum StatusChecklist {
  PENDENTE
  PREENCHIDO
  EM_ATRASO
  PENDENTE_APROVACAO
  APROVADO
  REPROVADO
}

enum JanelaChecklist {
  INICIO_EXPEDIENTE
  FIM_EXPEDIENTE
}

enum StatusMovimentoCaixa {
  ABERTO
  FECHADO
  PENDENTE_APROVACAO
}

enum StatusUsuario {
  ATIVO
  INATIVO
  BLOQUEADO
}

model ConfiguracaoPlataforma {
  id                Int      @id @default(1)
  providerName       String   @default("Fyberlink") @map("provider_name") @db.VarChar(120)
  logoDataUrl       String?  @map("logo_data_url") @db.Text
  brandPrimary      String   @default("#1d4ed8") @map("brand_primary") @db.VarChar(7)
  brandAccent       String   @default("#0f766e") @map("brand_accent") @db.VarChar(7)
  pageBackground    String   @default("#f8fafc") @map("page_background") @db.VarChar(7)
  surfaceBackground String   @default("#ffffff") @map("surface_background") @db.VarChar(7)
  textPrimary       String   @default("#0f172a") @map("text_primary") @db.VarChar(7)
  textSecondary     String   @default("#475569") @map("text_secondary") @db.VarChar(7)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("configuracao_plataforma")
}

model Usuario {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(160)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?   @map("password_changed_at")
  nome            String        @db.VarChar(160)
  telefone        String?       @db.VarChar(40)
  status          StatusUsuario @default(ATIVO)
  ultimoLogin     DateTime?     @map("ultimo_login")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  roles           UsuarioPerfil[]
  ordensAtribuidas OrdemRemocao[] @relation("OrdemRemocaoTecnico")
  ordensCriadas   OrdemRemocao[] @relation("OrdemRemocaoCriador")
  rotasRemocaoCriadas RotaRemocao[] @relation("RotaRemocaoCriador")
  rotasRemocaoCanceladas RotaRemocao[] @relation("RotaRemocaoCanceladaPor")
  rotasRemocaoTecnicoAnterior RotaRemocaoParada[] @relation("RotaRemocaoTecnicoAnterior")
  observacoesRemocao ObservacaoRemocao[]
  checklists      Checklist[]
  respostasResolvidas ChecklistResposta[] @relation("ChecklistRespostaResolucao")
  auditorias     LogAuditoria[] @relation("LogAuditoriaUsuario")
  movimentosCaixa MovimentacaoCaixa[]
  termosCriados  TermoResponsabilidade[] @relation("TermoCriador")
  termosDesignados TermoResponsabilidade[] @relation("TermoDesignado")

  @@map("usuarios")
}

model Perfil {
  id          String        @id @default(uuid()) @db.Uuid
  code        RoleCode      @unique
  nome        String        @db.VarChar(80)
  descricao   String?       @db.Text
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  usuarios    UsuarioPerfil[]
  permissoes  PerfilPermissao[]

  @@map("perfis")
}

model Permissao {
  id          String        @id @default(uuid()) @db.Uuid
  code        PermissionCode @unique
  nome        String        @db.VarChar(120)
  descricao   String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  perfis      PerfilPermissao[]

  @@map("permissoes")
}

model UsuarioPerfil {
  usuarioId String @map("usuario_id") @db.Uuid
  perfilId  String @map("perfil_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil  Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([usuarioId, perfilId])
  @@map("usuarios_perfis")
}

model PerfilPermissao {
  perfilId    String @map("perfil_id") @db.Uuid
  permissaoId String @map("permissao_id") @db.Uuid

  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissaoId])
  @@map("perfis_permissoes")
}

model OrdemRemocao {
  id                  String                     @id @default(uuid()) @db.Uuid
  clienteNome         String                     @map("cliente_nome") @db.VarChar(180)
  endereco            String                     @db.VarChar(255)
  numero              String                     @default("S/N") @db.VarChar(30)
  bairro              String                     @db.VarChar(120)
  pontoReferencia     String                     @default("Não informado") @map("ponto_referencia") @db.VarChar(255)
  localizacao         String                     @default("Não informado") @db.VarChar(500)
  regiao              String                     @db.VarChar(120)
  equipamentoSerial   String?                    @map("equipamento_serial") @db.VarChar(120)
  telefoneContato     String?                    @map("telefone_contato") @db.VarChar(40)
  status              StatusOrdemRemocao         @default(ABERTO)
  tentativasFalha     Int                        @default(0) @map("tentativas_falha")
  substatusFalha      SubstatusFalha?            @map("substatus_falha")
  fotoSerialUrl       String?                    @map("foto_serial_url") @db.Text
  fotoFachadaUrl      String?                    @map("foto_fachada_url") @db.Text
  tecnicoId           String?                    @map("tecnico_id") @db.Uuid
  criadoPorId         String?                    @map("criado_por_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  tecnico   Usuario? @relation("OrdemRemocaoTecnico", fields: [tecnicoId], references: [id])
  criadoPor Usuario? @relation("OrdemRemocaoCriador", fields: [criadoPorId], references: [id])
  observacoes ObservacaoRemocao[]
  paradasRota RotaRemocaoParada[]

  @@map("ordens_remocao")
}

model RotaRemocao {
  id          String            @id @default(uuid()) @db.Uuid
  criadoPorId String?           @map("criado_por_id") @db.Uuid
  origem      String            @db.VarChar(64)
  status      StatusRotaRemocao @default(EM_ANDAMENTO)
  distanciaKm Float             @map("distancia_km")
  createdAt   DateTime          @default(now()) @map("created_at")
  completedAt DateTime?         @map("completed_at")
  cancelledAt DateTime?         @map("cancelled_at")
  cancelledById String?         @map("cancelled_by_id") @db.Uuid

  criadoPor Usuario?              @relation("RotaRemocaoCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  canceladaPor Usuario?           @relation("RotaRemocaoCanceladaPor", fields: [cancelledById], references: [id])
  paradas   RotaRemocaoParada[]

  @@index([criadoPorId, createdAt])
  @@map("rotas_remocao")
}

model RotaRemocaoParada {
  id        String   @id @default(uuid()) @db.Uuid
  rotaId    String   @map("rota_id") @db.Uuid
  ordemId   String   @map("ordem_id") @db.Uuid
  sequencia Int
  statusAnterior StatusOrdemRemocao @default(ABERTO) @map("status_anterior")
  tecnicoAnteriorId String? @map("tecnico_anterior_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  rota  RotaRemocao  @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  ordem OrdemRemocao @relation(fields: [ordemId], references: [id], onDelete: Restrict)
  tecnicoAnterior Usuario? @relation("RotaRemocaoTecnicoAnterior", fields: [tecnicoAnteriorId], references: [id], onDelete: SetNull)

  @@unique([rotaId, ordemId])
  @@unique([rotaId, sequencia])
  @@index([ordemId])
  @@map("rotas_remocao_paradas")
}

model ObservacaoRemocao {
  id        String      @id @default(uuid()) @db.Uuid
  ordemId   String      @map("ordem_id") @db.Uuid
  usuarioId String?     @map("usuario_id") @db.Uuid
  texto     String      @db.Text
  createdAt DateTime    @default(now()) @map("created_at")

  ordem   OrdemRemocao @relation(fields: [ordemId], references: [id], onDelete: Cascade)
  usuario Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ordemId, createdAt])
  @@map("observacoes_remocao")
}

model ChecklistTemplate {
  id            String              @id @default(uuid()) @db.Uuid
  categoria     String              @default("GERAL") @db.VarChar(40)
  pergunta      String              @db.VarChar(255)
  tipoResposta  TipoRespostaChecklist @map("tipo_resposta")
  obrigatoria   Boolean             @default(true)
  itemCritico   Boolean             @default(false) @map("item_critico")
  ativo         Boolean             @default(true)
  createdAt     DateTime            @default(now()) @map("created_at")
  respostas     ChecklistResposta[]

  @@map("checklist_templates")
}

model Checklist {
  id                String           @id @default(uuid()) @db.Uuid
  usuarioId         String?          @map("usuario_id") @db.Uuid
  usuarioNome       String?          @map("usuario_nome") @db.VarChar(160)
  categoria         String           @default("GERAL") @db.VarChar(40)
  janela            JanelaChecklist?
  dataAgenda        DateTime?        @map("data_agenda") @db.Date
  dataPrevista      DateTime?        @map("data_prevista")
  dataPreenchimento DateTime?        @map("data_preenchimento")
  status            StatusChecklist  @default(PENDENTE)
  justificativaAtraso String?         @map("justificativa_atraso") @db.Text
  assinaturaData    String?           @map("assinatura_data") @db.Text
  excluidoEm       DateTime?          @map("excluido_em")
  aprovadoPorId     String?          @map("aprovado_por_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  usuario         Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  respostas       ChecklistResposta[]

  @@map("checklists")
  @@unique([usuarioId, categoria, janela, dataAgenda])
}

model ChecklistResposta {
  id                   String              @id @default(uuid()) @db.Uuid
  checklistId          String              @map("checklist_id") @db.Uuid
  templateId           String              @map("template_id") @db.Uuid
  valorTexto           String?             @map("valor_texto") @db.Text
  valorBooleano        Boolean?            @map("valor_booleano")
  respostaTipo         TipoRespostaChecklist @map("resposta_tipo")
  itemCritico          Boolean             @default(false) @map("item_critico")
  resolvidoEm          DateTime?           @map("resolvido_em")
  resolvidoPorId       String?             @map("resolvido_por_id") @db.Uuid
  registradoEm         DateTime            @default(now()) @map("registrado_em")

  checklist      Checklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  template       ChecklistTemplate @relation(fields: [templateId], references: [id])
  resolvidoPor   Usuario?          @relation("ChecklistRespostaResolucao", fields: [resolvidoPorId], references: [id])

  @@map("checklist_respostas")
}

model MovimentacaoCaixa {
  id                 String               @id @default(uuid()) @db.Uuid
  operadorId         String?              @map("operador_id") @db.Uuid
  turnoAbertoEm      DateTime             @map("turno_aberto_em")
  turnoFechadoEm     DateTime?            @map("turno_fechado_em")
  valorEsperado      Decimal              @map("valor_esperado") @db.Decimal(12,2)
  valorEmMaos        Decimal              @map("valor_em_maos") @db.Decimal(12,2)
  divergencia        Decimal              @db.Decimal(12,2)
  justificativa      String?              @db.Text
  status             StatusMovimentoCaixa @default(ABERTO)
  aprovadoPorId      String?              @map("aprovado_por_id") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  operador Usuario? @relation(fields: [operadorId], references: [id], onDelete: SetNull)

  @@map("movimentacoes_caixa")
}

model LogAuditoria {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String?  @map("usuario_id") @db.Uuid
  autorMasterAdmin Boolean @default(false) @map("autor_master_admin")
  acao        String   @db.VarChar(255)
  entidade    String   @db.VarChar(120)
  entidadeId  String?  @map("entidade_id") @db.VarChar(80)
  valorAntigo Json?    @map("valor_antigo")
  valorNovo   Json?    @map("valor_novo")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation("LogAuditoriaUsuario", fields: [usuarioId], references: [id])

  @@map("logs_auditoria")
}

model TermoResponsabilidade {
  id                  String    @id @default(uuid()) @db.Uuid
  descricao           String    @db.Text
  criadoPorId         String?   @map("criado_por_id") @db.Uuid
  criadoPorNome       String    @map("criado_por_nome") @db.VarChar(160)
  usuarioDesignadoId  String?   @map("usuario_designado_id") @db.Uuid
  usuarioDesignadoNome String   @map("usuario_designado_nome") @db.VarChar(160)
  usuarioDesignadoEmail String  @map("usuario_designado_email") @db.VarChar(160)
  assinaturaData      String?   @map("assinatura_data") @db.Text
  assinadoEm          DateTime? @map("assinado_em")
  createdAt           DateTime  @default(now()) @map("created_at")

  criadoPor        Usuario? @relation("TermoCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  usuarioDesignado Usuario? @relation("TermoDesignado", fields: [usuarioDesignadoId], references: [id], onDelete: SetNull)

  @@index([usuarioDesignadoId, assinadoEm])
  @@index([createdAt])
  @@map("termos_responsabilidade")
}
